rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidUserDoc(data) {
      return data.keys().hasAll(['username', 'displayName', 'salt', 'hash', 'role', 'status', 'permissions']) &&
        data.username is string && data.username.size() >= 2 &&
        data.displayName is string &&
        data.salt is string && data.salt.size() >= 16 &&
        data.hash is string && data.hash.size() >= 32 &&
        data.role in ['admin', 'employee'] &&
        data.status in ['active', 'blocked'] &&
        data.permissions is map;
    }

    // User and Authentication collections (accessible in both server and Vercel client modes)
    match /app_users/{docId} {
      allow read: if true;
      allow create, update: if isValidUserDoc(request.resource.data);
      allow delete: if resource != null;
    }
    match /system_users/{docId} {
      allow read: if true;
      allow create, update: if isValidUserDoc(request.resource.data);
      allow delete: if resource != null;
    }
    match /user_sessions/{docId} {
      allow read, write: if true;
    }

    // Financial collections accessible by the Dmenos Contro application
    match /boletos/{boletoId} {
      allow read, write: if true;
    }
    match /closures/{closureId} {
      allow read, write: if true;
    }

    match /cash_withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    match /vales/{valeId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /bank_accounts/{accountId} {
      allow read, write: if true;
    }

    match /bank_transactions/{transactionId} {
      allow read, write: if true;
    }

    match /receivables/{receivableId} {
      allow read, write: if true;
    }

    match /calendar_notes/{noteId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
